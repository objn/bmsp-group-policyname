# Copy this file to .env and set your local PostgreSQL connection.
DATABASE_URL=postgres://gpn:gpn@localhost:5432/gpn?sslmode=disable
ADDR=:8080

# Alternatively omit DATABASE_URL and configure individual settings:
# POSTGRES_USER=gpn
# POSTGRES_PASSWORD=gpn
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=gpn
# POSTGRES_SSLMODE=disable

ADMIN_USER=admin
ADMIN_PASSWORD_SHA256=replace_with_64_char_sha256_hex
COOKIE_SECURE=false
